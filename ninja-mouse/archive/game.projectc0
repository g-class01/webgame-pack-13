[project]
title = Ninja mouse
version = 0.0.1
write_log = 0
compress_archive = 1
publisher = unnamed
developer = unnamed
custom_resources = assets/bundle/common/levels/result/
bundle_exclude_resources = 
bundle_resources = assets/bundle
title_as_file_name = Ninjamouse

[display]
width = 960
height = 540
high_dpi = 1
samples = 0
fullscreen = 0
update_frequency = 60
vsync = 0
display_profiles = /builtins/render/default.display_profilesc
dynamic_orientation = 0
display_device_info = 0

[render]
clear_color_red = 0
clear_color_green = 0
clear_color_blue = 0
clear_color_alpha = 0

[physics]
type = 2D
gravity_y = -600.0
debug = 0
debug_alpha = 0.9
world_count = 4
gravity_x = 0
gravity_z = 0
scale = 0.01
allow_dynamic_transforms = 1
debug_scale = 30
max_collisions = 1
max_contacts = 1
contact_impulse_limit = 0
ray_cast_limit_2d = 1
ray_cast_limit_3d = 1
trigger_overlap_capacity = 1
velocity_threshold = 1

[bootstrap]
main_collection = /init.collectionc
render = /render/my.renderc

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_draw_calls = 1024
max_characters = 8192
max_debug_vertices = 10000
texture_profiles = /render/my.texture_profiles
verify_graphics_calls = 0
memory_size = 512

[shader]
output_spirv = 0

[sound]
gain = 1
max_sound_data = 64
max_sound_buffers = 32
max_sound_sources = 32
max_sound_instances = 64
max_component_count = 64
use_thread = 1

[resource]
http_cache = 0
max_resources = 1024

[input]
repeat_delay = 0.5
repeat_interval = 0.2
gamepads = /builtins/input/default.gamepadsc
game_binding = /imgui.input_bindingc
use_accelerometer = 0

[sprite]
max_count = 1024
subpixels = 1

[model]
max_count = 8

[mesh]
max_count = 64

[gui]
max_count = 16
max_particlefx_count = 64
max_particle_count = 1024

[collection]
max_instances = 2048
max_input_stack_entries = 16

[collection_proxy]
max_count = 8

[collectionfactory]
max_count = 64

[factory]
max_count = 64

[ios]
launch_screen = /builtins/manifests/ios/LaunchScreen.storyboardc
pre_renderered_icons = 0
bundle_identifier = com.d954mas.game.canon
infoplist = /builtins/manifests/ios/Info.plist
default_language = en
localizations = en

[android]
version_code = 1
minimum_sdk_version = 16
target_sdk_version = 30
package = com.d954mas.7spot.ninjamouse
manifest = /builtins/manifests/android/AndroidManifest.xml
iap_provider = GooglePlay
input_method = KeyEvent
immersive_mode = 0
display_cutout = 1
debuggable = 0
gcm_sender_id = 
push_field_text = 

[osx]
infoplist = /builtins/manifests/osx/Info.plist
bundle_identifier = example.unnamed
bundle_version = 1
default_language = en
localizations = en

[windows]
iap_provider = 

[html5]
custom_heap_size = 0
heap_size = 128
htmlfile = /platform/web/engine_template.html
cssfile = /platform/web/dark_theme.css
archive_location_prefix = archive
show_fullscreen_button = 1
show_made_with_defold = 0
show_console_banner = 1
scale_mode = no_scale
splash_image = 

[particle_fx]
max_count = 16
max_emitter_count = 64
max_particle_count = 256

[iap]
auto_finish_transactions = 1

[network]
http_timeout = 0
http_thread_count = 4
http_cache_enabled = 1

[library]
include_dirs = 

[script]
shared_state = 1

[label]
max_count = 1
subpixels = 1

[profiler]
track_cpu = 1

[liveupdate]
settings = /liveupdate.settings
enabled = 1

[tilemap]
max_count = 0
max_tile_count = 0

[engine]
run_while_iconified = 1

[native_extension]
app_manifest = /app_manifest_release.appmanifest

[spine]
max_count = 0

[googleanalytics]
dispatch_period = 30
queue_save_period = 60000000
verbose = 0

