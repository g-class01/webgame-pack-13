[project]
title = Dual Cat
version = v1.2.7
write_log = 0
compress_archive = 1
publisher = Seal Unicorn Games
developer = Seal Unicorn Games
bundle_resources = /bundle
title_as_file_name = DualCat

[display]
width = 1280
height = 720
high_dpi = 1
samples = 0
fullscreen = 0
update_frequency = 0
swap_interval = 0
vsync = 0
display_profiles = /scripts/render/default.display_profilesc
dynamic_orientation = 0
display_device_info = 0

[render]
clear_color_red = 0
clear_color_green = 0
clear_color_blue = 0
clear_color_alpha = 0

[physics]
type = 3D
max_collision_object_count = 128
use_fixed_timestep = 1
gravity_y = -80.0
debug = 0
debug_alpha = 0.9
world_count = 5
gravity_x = 0
gravity_z = 0
scale = 1.0
allow_dynamic_transforms = 1
debug_scale = 1.0
max_collisions = 10000
max_contacts = 10000
contact_impulse_limit = 0
ray_cast_limit_2d = 1000
ray_cast_limit_3d = 1000
trigger_overlap_capacity = 100
velocity_threshold = 1
max_fixed_timesteps = 2

[bootstrap]
main_collection = /assets/screens/init.collectionc
render = /scripts/render/main.renderc

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_draw_calls = 1024
max_characters = 8192
max_debug_vertices = 1000000
texture_profiles = /assets/graphics/default.texture_profiles
verify_graphics_calls = 0
memory_size = 512

[shader]
output_spirv = 0

[sound]
gain = 1
max_sound_data = 128
max_sound_buffers = 64
max_sound_sources = 16
max_sound_instances = 256
max_component_count = 64
use_thread = 1

[resource]
http_cache = 0
max_resources = 1024

[input]
repeat_delay = 0.5
repeat_interval = 0.2
gamepads = /builtins/input/default.gamepadsc
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[sprite]
max_count = 128
subpixels = 1

[model]
max_count = 512
split_meshes = 0

[mesh]
max_count = 128

[gui]
max_count = 64
max_particlefx_count = 64
max_particle_count = 1024
max_animation_count = 1024

[collection]
max_instances = 1024
max_input_stack_entries = 16

[collection_proxy]
max_count = 100

[collectionfactory]
max_count = 128

[factory]
max_count = 128

[ios]
app_icon_120x120 = /assets/images/thumbnail_splashscreen/AppIconIOS/AppIcon_120x120.png
app_icon_180x180 = /assets/images/thumbnail_splashscreen/AppIconIOS/AppIcon_180x180.png
